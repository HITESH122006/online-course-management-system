# Online Course Management System — Backend Environment Configuration
# -------------------------------------------------------------------
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to version control.
# -------------------------------------------------------------------

PORT=5000

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <cluster-url> with your Atlas credentials.
# Go to MongoDB Atlas → Clusters → Connect → Drivers → Node.js
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority&appName=Cluster0

# JSON Web Token secret (any long random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
